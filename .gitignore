# --- Sensitive / machine-local: never commit contents (keep the folders) ---
# Login sessions & cookies live here — committing them would leak VHP access.
profiles/*
!profiles/.gitkeep
# Downloaded report files (PMS data) and run logs stay on the PC.
downloads/*
!downloads/.gitkeep
logs/*
!logs/.gitkeep

# ChromeDriver binary is downloaded per-machine (v109), not version-controlled.
chromedriver.exe
chromedriver

# Local secrets — VHP logins + the dashboard API token live here, NEVER committed.
.env
credentials.py
import_token.txt
.import_token
cancellation_token.txt
*_token.txt

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
